  "components": {
    "schemas": {
      "AgendamentoRequest": {
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "integer",
            "format": "int32"
          },
          "dataHora": {
            "type": "string",
            "format": "date-time"
          },
          "qtdPessoas": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "isPcd": {
            "type": "boolean"
          },
          "nomePcd": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "tipoPcd": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AlterarStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CadastroRequest": {
        "required": [
          "nome",
          "senha",
          "usuario"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "usuario": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          },
          "senha": {
            "maxLength": 100,
            "minLength": 4,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CupomRequest": {
        "required": [
          "codigoCupom",
          "nomePromocao"
        ],
        "type": "object",
        "properties": {
          "usuarioId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "nomePromocao": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "codigoCupom": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "FavoritoRequest": {
        "required": [
          "pratoNome"
        ],
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "integer",
            "format": "int32"
          },
          "pratoNome": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "preco": {
            "maximum": 100000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "FilaRequest": {
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "integer",
            "format": "int32"
          },
          "qtdPessoas": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "string",
            "nullable": true
          },
          "senha": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PedidoRequest": {
        "required": [
          "itensJson"
        ],
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "integer",
            "format": "int32"
          },
          "itensJson": {
            "minLength": 1,
            "type": "string"
          },
          "valorTotal": {
            "maximum": 100000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ValidarCodigoRequest": {
        "type": "object",
        "properties": {
          "codigoCupom": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValidarCupomRequest": {
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "integer",
            "format": "int32"
          },
          "codigoCupom": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Informe apenas o token JWT obtido em /api/usuarios/login.",
        "scheme": "bearer",
